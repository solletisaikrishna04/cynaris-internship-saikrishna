SELECT*FROM Sale


SELECT COUNT(*) AS TOTAL_NO_OF_SALES FROM Sale

SELECT Region,COUNT(*) from sale
GROUP BY Region

SELECT SUM(Amount) AS TOTAL_REVENUE FROM Sale

SELECT Category,SUM(Amount) AS TOTAL_REVENUE FROM Sale
GROUP BY Category

SELECT Region,AVG(Amount) AS AVG_SALE FROM Sale
GROUP BY Region

SELECT Category,AVG(Quantity) AS AVG_QUANTITY FROM Sale
GROUP BY Category

SELECT MAX(Amount) AS HighestSale FROM Sale


SELECT MIN(Amount) AS LowsetSale FROM Sale

SELECT Region,Category,MONTH(SaleDate) AS MONTH FROM Sale
GROUP BY Region,Category,MONTH(SaleDate)

SELECT Region,COUNT(*) AS TotalSales FROM Sale
GROUP BY Region
HAVING COUNT(*) >2

SELECT
    SaleID,
    Amount,
    SUM(Amount) OVER() AS TotalRevenue
FROM Sale;
