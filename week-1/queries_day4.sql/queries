SELECT * FROM Sale_Practice;

SELECT* FROM Sale_Practice
WHERE Amount>
(SELECT AVG(Amount) FROM Sale_Practice)

SELECT*FROM Sale_Practice S1
WHERE Amount=(
        SELECT MAX(AMOUNT)
        FROM Sale_Practice S2
        WHERE S2.Region=S1.Region);


WITH AverageSales AS
(
SELECT AVG(Amount) AS AvgAmount
FROM Sale_Practice)
SELECT* FROM Sale_Practice
WHERE Amount>(
SELECT AvgAmount FROM AverageSales);

WITH RegionSales AS
(
SELECT Region,AVG(Amount) AVG_SALES
FROM Sale_Practice
GROUP BY Region
)
,OverallSales AS 
(SELECT AVG(Amount) OverAllAvg
FROM Sale_Practice)
SELECT R.Region,R.AVG_SALES,O.OverAllAvg
FROM RegionSales R CROSS JOIN OverallSales O
WHERE R.AVG_SALES>O.OverAllAvg